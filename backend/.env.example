# DriftGuard Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database: Uses SQLite for zero-setup local dev.
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/driftguard
DATABASE_URL=sqlite:///./driftguard.db

# Storage Directories
ARTIFACTS_DIR=./artifacts
DATA_DIR=../data

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
