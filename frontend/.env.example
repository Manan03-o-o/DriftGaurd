# ── Local development ─────────────────────────────────────────────────────────
# Leave VITE_API_URL unset (or empty) so the Vite dev-server proxy forwards
# /api and /health requests to http://127.0.0.1:8000 automatically.
#
# VITE_API_URL=

# ── Production (Vercel) ───────────────────────────────────────────────────────
# Set this in your Vercel project → Settings → Environment Variables.
# It must NOT have a trailing slash.
#
VITE_API_URL=https://driftgaurd.onrender.com
